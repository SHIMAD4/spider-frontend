{
    "name": "spider",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "eslint src",
        "lint:fsd": "steiger ./src",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,css,json,md}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.12.0",
        "clsx": "^2.1.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-redux": "^9.3.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@feature-sliced/steiger-plugin": "^0.7.0",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.6",
        "sass": "^1.103.1",
        "steiger": "^0.6.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0"
    }
}
