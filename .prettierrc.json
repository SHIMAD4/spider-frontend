{
    "singleQuote": true,
    "semi": false,
    "tabWidth": 4,
    "printWidth": 80,
    "trailingComma": "all",
    "jsxSingleQuote": true,
    "bracketSpacing": true,

    "plugins": ["@trivago/prettier-plugin-sort-imports"],

    "importOrder": [
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "^@app/(.*)$",
        "^@pages/(.*)$",
        "^@widgets/(.*)$",
        "^@features/(.*)$",
        "^@entities/(.*)$",
        "^@shared/(.*)$",
        "^@/(.*)$",
        "^[../]",
        "^[./]"
    ],

    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
}
